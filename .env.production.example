# Producción BMAX — precios.meincart.com
# Copiar a .env en el servidor (prod-menu opción 1). No publicar Mongo/Redis.

MONGODB_URI=mongodb://precios-mongo:27017
MONGODB_DB=scraping
QDRANT_URL=http://precios-qdrant:6333
QDRANT_COLLECTION=products
REDIS_URL=redis://precios-redis:6379/0

# Worker soyo (ver docs/bmax/SOYO_WORKER.md). Dejar vacío hasta tener Tailscale/WG.
# Solo con BMAX_VPN_IP definido, deploy-prod aplica docker-compose.prod.soyo-access.yml
# (bind 27018/6380 en esa IP — nunca 0.0.0.0).
# BMAX_VPN_IP=
# PRECIOS_MONGO_HOST_PORT=27018
# PRECIOS_REDIS_HOST_PORT=6380
# Tras cutover a soyo: HOST_BATCH_CRON=0 para que deploy/opción 8 no reinstale ofertas en BMAX
# (sí deja predictive run_on_bmax.sh). Mientras tanto dejar 1 o omitir.
# HOST_BATCH_CRON=1
RETAIL_THUMBS=1
RETAIL_THUMB_SIDE=240
RETAIL_THUMB_LIMIT=24
RETAIL_STORE_WORKERS=8
# Requiere el registro DNS/proxy de lnk.meincart.cl hacia BMAX.
# Si no está disponible, usar temporalmente https://precios.meincart.cl.
SHORT_LINK_BASE_URL=https://lnk.meincart.cl
SHORT_LINK_OFFSET=237000000

# Inteligencia comercial (opcionales)
# Valida stock por simulación, sin crear carrito ni orden. Lista separada por comas.
STOCK_VALIDATION_STORES=easy
STOCK_VALIDATION_MAX=50
# Respaldo local para completar datos comerciales ausentes. Requiere Ollama.
COMMERCIAL_LLM_ENABLED=0
COMMERCIAL_LLM_MODEL=llama3.2:3b
COMMERCIAL_LLM_TIMEOUT=8
COMMERCIAL_LLM_MAX_PER_BATCH=10

# Sesiones y admin (obligatorio en prod: si falta, cada recreate invalida logins)
RETAIL_SECRET=cambia-esto-por-un-hex-largo
RETAIL_COOKIE_SECURE=1
# Mantiene activas las barreras contra consultas automatizadas y extracción masiva.
RETAIL_ANTI_SCRAPING=1
RETAIL_ADMIN_EMAIL=admin@meincart.com
RETAIL_ADMIN_PASSWORD=Ragr13798@

# Web Push al celular (opcionales). Si faltan, la app genera y guarda llaves VAPID en Mongo.
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_SUBJECT=mailto:alertas@meincart.cl

# Telegram (opcionales). Preferible configurarlas en /ofertas (se guardan en
# output/canales.local.json y, desde el fix de persistencia, también en Mongo).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Capturas de página solo al enviar alertas Telegram/correo (no en cada scrape).
# Requiere Playwright+Chromium (Dockerfile.screenshots o install manual). Ver docs/offer_screenshots.md.
# OFFER_SCREENSHOTS=0
# OFFER_SCREENSHOT_TIMEOUT_MS=15000
# OFFER_SCREENSHOT_RETENTION_DAYS=7
# OFFER_SCREENSHOT_DIR=output/offer_screenshots

# Imagen opcional con Chromium para capturas en alertas Telegram/correo.
# La imagen slim (Dockerfile) sigue siendo la de precios-web por defecto.
# Uso: docker compose -f docker-compose.prod.yml build --build-arg ...
#   o: docker build -f Dockerfile.screenshots -t precios-web:screenshots .
#
# En BMAX el cron hace `docker exec precios-web retail batch ...`, así que si
# quieres capturas hay que desplegar esta imagen como precios-web (o instalar
# Playwright a mano en el contenedor). Sin OFFER_SCREENSHOTS=1 no se captura.

FROM python:3.12-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY retail ./retail
COPY data ./data

RUN pip install --no-cache-dir -e ".[screenshots]" \
    && playwright install --with-deps chromium

ENV PYTHONUNBUFFERED=1 \
    MONGODB_URI=mongodb://precios-mongo:27017 \
    MONGODB_DB=scraping \
    QDRANT_URL=http://precios-qdrant:6333 \
    REDIS_URL=redis://precios-redis:6379/0 \
    OFFER_SCREENSHOTS=0

EXPOSE 8080

CMD ["uvicorn", "retail.web.app:app", "--host", "0.0.0.0", "--port", "8080"]

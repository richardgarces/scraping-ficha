{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 .github/hooks/project_context.py",
        "windows": "py -3 .github/hooks/project_context.py",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "python3 .github/hooks/guard_sensitive_actions.py",
        "windows": "py -3 .github/hooks/guard_sensitive_actions.py",
        "timeout": 5
      }
    ]
  }
}

# Worker soyo → datos en BMAX (NO commitear el .env real).
# Copiar a .env en soyo tras VPN + auth + override soyo-access en BMAX.

# IP Tailscale/WireGuard de BMAX (preferido). Alternativa: LAN si el firewall es estricto.
# Puertos host por defecto del override: 27018 (mongo) y 6380 (redis).
MONGODB_URI=mongodb://precios_soyo:CAMBIA_PASS@100.x.x.x:27018/?authSource=admin
MONGODB_DB=scraping
REDIS_URL=redis://:CAMBIA_REDIS_PASS@100.x.x.x:6380/0
# Qdrant solo si el batch vectoriza desde soyo (puerto comentado en soyo-access por defecto)
# QDRANT_URL=http://100.x.x.x:6333
QDRANT_COLLECTION=products

# Batch / scrape (ajustar como en BMAX)
# ADAPTIVE_SCRAPING=1
# RETAIL_STORE_WORKERS=8
# OFFER_SCREENSHOTS=0
